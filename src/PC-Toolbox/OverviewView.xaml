                        <TextBlock x:Name="BeschrTreiber" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Commander" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🗂️" FontSize="26" />
                        <TextBlock x:Name="TitelCommander" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrCommander" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Bluescreen" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="26" />
