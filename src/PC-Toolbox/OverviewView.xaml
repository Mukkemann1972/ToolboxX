                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Registry" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🗝️" FontSize="26" />
                        <TextBlock x:Name="TitelRegistry" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrRegistry" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Drucker" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🖨️" FontSize="26" />
                        <TextBlock x:Name="TitelDrucker" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrDrucker" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="UsbGeraete" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🔌" FontSize="26" />
                        <TextBlock x:Name="TitelUsb" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrUsb" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock x:Name="FusszeileText" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
