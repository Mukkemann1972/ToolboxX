<UserControl x:Class="PCToolbox.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- === Hero-Banner mit Alex' Logo ===
                 Hintergrund bewusst Schwarz (nicht BgPanelBrush): das Logo-PNG hat einen
                 schwarzen Grund, dessen Neon-Glow ins Schwarz ausläuft - auf gleichem
                 Schwarz verschmilzt es nahtlos statt als sichtbarer Kasten zu wirken.
                 MaxWidth bewusst gesetzt: ohne sie zieht sich die schwarze Flaeche auf
                 breiten/maximierten Fenstern zu einem riesigen leeren Balken mit einem
                 kleinen Logo in der Mitte. Mit MaxWidth bleibt die Banner-Groesse
                 proportional und zentriert sich einfach im verfuegbaren Platz - die
                 Kachel-Reihe darunter bleibt bewusst ungebunden, damit dort auf breiten
                 Fenstern mehr Kacheln pro Zeile passen. -->
            <Border Background="#000000" CornerRadius="12" Padding="20,22" Margin="0,0,0,20"
                    MaxWidth="900" HorizontalAlignment="Stretch">
                <StackPanel>
                    <!-- x:Name nur fuer den Pro-Build (s. OverviewView.xaml.cs #if PRO_BUILD),
                         der hier zur Laufzeit das Pro-Logo einsetzt. -->
                    <Image x:Name="HeroLogoBild" Source="Assets/ToolboxX-Logo.png" Stretch="Uniform"
                           MaxHeight="185" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TaglineZeile1" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="13"
                               FontFamily="{StaticResource AccentFontFamily}"
                               Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" />
                    <TextBlock x:Name="TaglineZeile2" HorizontalAlignment="Center" FontSize="13"
                               FontFamily="{StaticResource AccentFontFamily}"
                               Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- === Kachel-Grid: reale Module, keine Beispiel-Deko ===
                 Titel/Beschreibung bewusst ohne Text-Attribut: werden im Code-Behind
                 per Loc.T(...) gesetzt (s. OverviewView.xaml.cs), damit Deutsch/Englisch
                 direkt nebeneinander stehen statt in XAML escaped werden zu muessen. -->
            <!-- KachelnPanel: Name nur fuer den Pro-Build, der hier per Code (s. OverviewView.xaml.cs
                 #if PRO_BUILD) eigene Kacheln anhaengt - im Free-Build bleibt dieser Codepfad
                 unkompiliert, hier steht also nichts Pro-Spezifisches. -->
            <WrapPanel x:Name="KachelnPanel" Orientation="Horizontal">
                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="System" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🖥️" FontSize="26" />
                        <TextBlock x:Name="TitelSystem" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrSystem" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Laufwerke" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="💾" FontSize="26" />
                        <TextBlock x:Name="TitelLaufwerke" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrLaufwerke" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Temperatur" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🌡️" FontSize="26" />
                        <TextBlock x:Name="TitelTemperatur" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrTemperatur" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="GpuDiagnose" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🎮" FontSize="26" />
                        <TextBlock x:Name="TitelGpuDiagnose" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrGpuDiagnose" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="RamDisk" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="💽" FontSize="26" />
                        <TextBlock x:Name="TitelRamDisk" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrRamDisk" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Autostart" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🚀" FontSize="26" />
                        <TextBlock x:Name="TitelAutostart" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrAutostart" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Dienste" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="⚙️" FontSize="26" />
                        <TextBlock x:Name="TitelDienste" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrDienste" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Datentraeger" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🗄️" FontSize="26" />
                        <TextBlock x:Name="TitelDatentraeger" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrDatentraeger" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Netzwerk" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🌐" FontSize="26" />
                        <TextBlock x:Name="TitelNetzwerk" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
