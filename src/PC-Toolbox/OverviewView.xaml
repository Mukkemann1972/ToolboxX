                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="Saubermacher" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🧽" FontSize="26" />
                        <TextBlock x:Name="TitelSaubermacher" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrSaubermacher" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileCardStyle}" Width="190" Height="120" Margin="0,0,14,14"
                        Tag="WindowsReparatur" Click="Kachel_Click">
                    <StackPanel>
                        <TextBlock Text="🩹" FontSize="26" />
                        <TextBlock x:Name="TitelWindowsReparatur" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource BodyFontFamily}" Margin="0,8,0,2" />
                        <TextBlock x:Name="BeschrWindowsReparatur" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
