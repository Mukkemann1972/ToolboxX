<UserControl x:Class="PCToolbox.Modules.GpuDiagnoseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,6" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

            <!-- === Erkannte Grafikkarten === -->
            <TextBlock x:Name="ErkannteGrafikkartenTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ItemsControl x:Name="GpuListe" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Titel}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- === Live-Auslastung === -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="LiveAuslastungTitel" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="AuslastungBalken" Grid.Column="0" Height="10" Minimum="0" Maximum="100"
                                     Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" VerticalAlignment="Center" />
                        <TextBlock x:Name="AuslastungText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="–" MinWidth="40" TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- === VRAM-Test === -->
            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="VramTestTitel" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="TestdauerLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="DauerAuswahl" Width="140" SelectedIndex="0">
                            <ComboBoxItem x:Name="Dauer1MinItem" Tag="1" />
                            <ComboBoxItem x:Name="Dauer5MinItem" Tag="5" />
                            <ComboBoxItem x:Name="Dauer15MinItem" Tag="15" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestButton" Padding="12,6" Click="TestStarten_Click" />
                        <Button x:Name="AbbrechenButton" Padding="12,6" Margin="8,0,0,0"
                                IsEnabled="False" Click="Abbrechen_Click" />
                    </StackPanel>

                    <TextBlock x:Name="StatusZeile" Margin="0,10,0,0" FontStyle="Italic"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

                    <!-- === Ergebnis === -->
                    <Border x:Name="ErgebnisPanel" Visibility="Collapsed" Background="{StaticResource BgCardBrush}"
                            CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ErgebnisTitel" FontWeight="Bold" FontSize="15" />
                            <TextBlock x:Name="ErgebnisText" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- === Erklaerung fuer Laien === -->
            <TextBlock x:Name="AmpelErklaerungTitel" Margin="0,16,0,0" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                <Run x:Name="AmpelGruenText" />
                <LineBreak />
                <Run x:Name="AmpelGelbText" />
                <LineBreak />
                <Run x:Name="AmpelRotText" />
            </TextBlock>

            <TextBlock x:Name="TestmotorHinweis" Margin="0,14,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
