<UserControl x:Class="PCToolbox.Modules.TemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="TitelText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,10" />
        <TextBlock x:Name="QuelleHinweis" DockPanel.Dock="Top" Style="{StaticResource QuelleHinweisStyle}" />
        <StackPanel x:Name="InstallierenPanel" DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="InstallierenErklaerung" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <Button x:Name="PawnIoInstallierenButton" Click="PawnIoInstallieren_Click"
                    Padding="18,10" HorizontalAlignment="Left" />
            <TextBlock x:Name="InstallierenMeldung" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,6">
                            <StackPanel>
                                <ContentControl Content="{Binding Titel, Converter={StaticResource AmpelPrefixTextConverter}}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap" Foreground="Gray" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
