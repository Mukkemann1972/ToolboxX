<UserControl x:Class="PCToolbox.Modules.SystemSaubermacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="TitelText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,6" />
        <TextBlock x:Name="EinleitungText" DockPanel.Dock="Top" Foreground="#666" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBlock x:Name="QuelleHinweis" DockPanel.Dock="Top" Style="{StaticResource QuelleHinweisStyle}" />

        <TextBlock x:Name="StatusZeile" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontStyle="Italic" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding BereinigenBeschriftung}" Padding="8,2"
                                        VerticalAlignment="Top"
                                        Click="Bereinigen_Click" Tag="{Binding Befund}" />
                                <StackPanel Margin="0,0,10,0">
                                    <ContentControl Content="{Binding Titel, Converter={StaticResource AmpelPrefixTextConverter}, ConverterParameter=15}"
                                                    FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="{Binding GroesseZeile}" Foreground="#333" Margin="0,2,0,6" />
                                    <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Erklaerung}" TextWrapping="Wrap" Foreground="#666" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
