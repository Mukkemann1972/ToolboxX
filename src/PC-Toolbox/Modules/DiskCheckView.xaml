<UserControl x:Class="PCToolbox.Modules.DiskCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="TitelText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,10" />
        <TextBlock x:Name="QuelleHinweis" DockPanel.Dock="Top" Style="{StaticResource QuelleHinweisStyle}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,6">
                            <StackPanel>
                                <ContentControl Content="{Binding Titel, Converter={StaticResource AmpelPrefixTextConverter}}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SpeicherZeile}" />
                                <ContentControl Content="{Binding SmartZeile, Converter={StaticResource AmpelPrefixTextConverter}, ConverterParameter=13}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
