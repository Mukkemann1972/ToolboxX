<UserControl x:Class="PCToolbox.Modules.SecurityAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
                <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="PruefenButton" Click="Pruefen_Click" Padding="16,9" Margin="0,0,14,0" />
                    <TextBlock x:Name="GesamtbildText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar x:Name="FortschrittBalken" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,14" />

                <StackPanel x:Name="ErgebnisBereich" />

                <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                    <TextBlock x:Name="HinweisText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
