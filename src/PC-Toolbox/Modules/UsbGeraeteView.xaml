<UserControl x:Class="PCToolbox.Modules.UsbGeraeteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <Button x:Name="NeuLadenButton" DockPanel.Dock="Bottom" Click="NeuLaden_Click" Padding="12,6"
                HorizontalAlignment="Left" Margin="0,10,0,0" />

        <ScrollViewer x:Name="HauptScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
                <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
                <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                           TextWrapping="Wrap" />

                <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="EnergiesparTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="EnergiesparText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ZusammenfassungText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="ProZusatzBereich" />

                <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Kurzform}" Foreground="{Binding AmpelFarbe}"
                                               FontWeight="SemiBold" Margin="0,4,0,6" TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Empfehlung}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" />

                                    <TextBlock Text="{Binding Herkunft}" FontSize="11" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
