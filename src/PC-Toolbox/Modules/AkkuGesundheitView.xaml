<UserControl x:Class="PCToolbox.Modules.AkkuGesundheitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ScrollViewer x:Name="HauptScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
                <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />
                <Button x:Name="NeuLadenButton" Click="NeuLaden_Click" Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,14" />

                <Border x:Name="ErgebnisKarte" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ErgebnisTitel" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                        <TextBlock x:Name="ErgebnisText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />
                        <ProgressBar x:Name="GesundheitsBalken" Height="10" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />

                <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="AufweckTitel" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                        <TextBlock x:Name="AufweckEinleitung" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />
                        <TextBlock x:Name="AufweckText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ProZusatzBereich" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
