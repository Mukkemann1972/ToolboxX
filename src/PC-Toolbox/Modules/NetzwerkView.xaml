<UserControl x:Class="PCToolbox.Modules.NetzwerkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="UrteilText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="PruefenButton" Click="Pruefen_Click" Padding="14,7" />
            <TextBlock x:Name="AdapterText" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Titel}" FontWeight="Bold" FontSize="15"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Ergebnis}" Foreground="{Binding AmpelFarbe}"
                                               FontWeight="SemiBold" Margin="0,4,0,6" TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Empfehlung}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- "Wer redet mit draußen?" - ergaenzt die Kettenpruefung oben um die Frage,
                     welches Programm gerade tatsaechlich eine Verbindung offen hat
                     (Rang 4 aus der NirSoft-Recherche, Vorbild CurrPorts). -->
                <Expander x:Name="VerbindungenBereich" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="VerbindungenHinweis" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="VerbindungenListe">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Dauerhafte Verbindungsueberwachung: die Pruefung oben ist eine
                     Momentaufnahme und kann "das Internet geht MANCHMAL weg" grundsaetzlich
                     nicht finden (Rang 5 aus der NirSoft-Recherche, Vorbild PingInfoView). -->
                <Expander x:Name="UeberwachungBereich" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="UeberwachungErklaerung" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                        <Button x:Name="UeberwachungButton" Click="Ueberwachung_Click" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock x:Name="UeberwachungStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
                        <ItemsControl x:Name="AusfallListe">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
