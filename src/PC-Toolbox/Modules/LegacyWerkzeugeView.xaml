<UserControl x:Class="PCToolbox.Modules.LegacyWerkzeugeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="TitelText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
        <TextBlock x:Name="EinleitungText" DockPanel.Dock="Top" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="SucheLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SucheBox" Padding="6,4" TextChanged="Suche_Changed" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Liste" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
