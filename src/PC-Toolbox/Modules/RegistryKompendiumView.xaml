<UserControl x:Class="PCToolbox.Modules.RegistryKompendiumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="TitelText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
        <TextBlock x:Name="QuelleHinweis" DockPanel.Dock="Top" Style="{StaticResource QuelleHinweisStyle}" />
        <TextBlock x:Name="EinleitungText" DockPanel.Dock="Top" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                   TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Titel}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Pfad}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="{Binding Erklaerung}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding BefundText}" Foreground="{Binding AmpelFarbe}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding AktuellerWertZeile}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
