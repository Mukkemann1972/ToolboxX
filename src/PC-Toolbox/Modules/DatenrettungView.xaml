<UserControl x:Class="PCToolbox.Modules.DatenrettungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

            <TextBlock x:Name="PlatteLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <ComboBox x:Name="PlatteBox" Padding="6,4" Margin="0,0,0,14" SelectionChanged="Auswahl_Geaendert" />

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed" x:Name="PapierkorbBereich">
                <StackPanel>
                    <TextBlock x:Name="PapierkorbTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="PapierkorbText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                    <Button x:Name="PapierkorbDurchsuchenButton" Click="PapierkorbDurchsuchen_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <TextBlock x:Name="PapierkorbStatusText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DockPanel x:Name="PapierkorbErgebnisBereich" Visibility="Collapsed" MaxHeight="220" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TypenLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,14">
                <CheckBox x:Name="JpegBox" IsChecked="True" Margin="0,0,20,6" Content="JPEG (Fotos)" />
                <CheckBox x:Name="PngBox" IsChecked="True" Margin="0,0,20,6" Content="PNG (Bilder)" />
                <CheckBox x:Name="GifBox" IsChecked="True" Margin="0,0,20,6" Content="GIF (Bilder)" />
                <CheckBox x:Name="PdfBox" IsChecked="True" Margin="0,0,20,6" Content="PDF (Dokumente)" />
                <CheckBox x:Name="ZipBox" IsChecked="True" Margin="0,0,20,6" Content="ZIP (auch DOCX/XLSX/PPTX)" />
            </WrapPanel>

            <TextBlock x:Name="ZielLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="ZielDurchsuchenButton" DockPanel.Dock="Right" Click="ZielDurchsuchen_Click" Padding="10,4" Margin="8,0,0,0" />
                <TextBox x:Name="ZielPfadFeld" Padding="6,4" IsReadOnly="True" />
            </DockPanel>
            <TextBlock x:Name="ZielInfoText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="NeuLadenButton" Click="NeuLaden_Click" Padding="14,7" Margin="0,0,10,0" />
                <Button x:Name="ScanButton" Click="Scan_Click" Padding="14,7" Margin="0,0,10,0" IsEnabled="False" />
                <Button x:Name="RettenButton" Click="Retten_Click" Padding="14,7" Margin="0,0,10,0" Visibility="Collapsed" />
                <Button x:Name="AbbrechenButton" Click="Abbrechen_Click" Padding="14,7" Visibility="Collapsed" />
            </StackPanel>

            <ProgressBar x:Name="FortschrittBalken" Height="8" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel x:Name="ErgebnisBereich" />
    </DockPanel>
</UserControl>
