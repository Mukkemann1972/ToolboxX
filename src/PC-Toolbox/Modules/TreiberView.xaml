<UserControl x:Class="PCToolbox.Modules.TreiberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="NichtsAutomatischTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="NichtsAutomatischText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ZusammenfassungText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="HinweisText" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="PruefenButton" Click="Pruefen_Click" Padding="14,7" Margin="0,0,12,0" />
            <CheckBox x:Name="AlleAnzeigenBox"
                      VerticalAlignment="Center" Click="AlleAnzeigen_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Nach Kategorie gruppiert (PNPClass), statt einer langen flachen Liste -
                 bei vielen Funden faellt es so leichter, den Ueberblick zu behalten. -->
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding Kategorie}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Zeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                                Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Kurzform}" Foreground="{Binding AmpelFarbe}"
                                                           FontWeight="SemiBold" Margin="0,4,0,6" TextWrapping="Wrap" />

                                                <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding Empfehlung}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMutedBrush}" />

                                                <TextBlock Text="{Binding Herkunft}" FontSize="11" Margin="0,8,0,0"
                                                           TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />

                                                <TextBlock Text="{Binding AbsturzHinweis}" FontSize="12" FontWeight="SemiBold"
                                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           Visibility="{Binding HatAbsturzHinweis, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
