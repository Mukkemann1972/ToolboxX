<UserControl x:Class="PCToolbox.Modules.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4" MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,24"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DesignLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button x:Name="ThemeDunkelButton" Click="ThemeDunkel_Click" Width="160" Height="90" Margin="0,0,14,0"
                        Background="#0A0E16" BorderThickness="2" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ThemeDunkelTitel" Foreground="#E8EDF4" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ThemeDunkelUntertitel" Foreground="#7C8AA3" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeHellButton" Click="ThemeHell_Click" Width="160" Height="90"
                        Background="#F4F6FA" BorderThickness="2" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ThemeHellTitel" Foreground="#1B2436" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ThemeHellUntertitel" Foreground="#64748B" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="AkzentfarbeLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <WrapPanel x:Name="AccentPanel" Margin="0,0,0,28" />

            <TextBlock Text="SPRACHE / LANGUAGE" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                <Button x:Name="SpracheDeutschButton" Click="SpracheDeutsch_Click" Width="160" Height="70" Margin="0,0,14,0"
                        BorderThickness="2" Cursor="Hand">
                    <TextBlock Text="Deutsch" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="SpracheEnglischButton" Click="SpracheEnglisch_Click" Width="160" Height="70"
                        BorderThickness="2" Cursor="Hand">
                    <TextBlock Text="English" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>

            <Button x:Name="ApplyButton" Click="Apply_Click"
                    HorizontalAlignment="Left" Padding="18,10" Margin="0,0,0,28" />

            <TextBlock x:Name="DiagnoseLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <TextBlock x:Name="DiagnoseErklaerung" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <Button x:Name="DiagnoseOeffnenButton" Click="DiagnoseOeffnen_Click"
                    HorizontalAlignment="Left" Padding="18,10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
