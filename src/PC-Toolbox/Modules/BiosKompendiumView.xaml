<UserControl x:Class="PCToolbox.Modules.BiosKompendiumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="TitelText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,10" />
        <TextBlock x:Name="QuelleHinweis" DockPanel.Dock="Top" Style="{StaticResource QuelleHinweisStyle}" />

        <TextBlock DockPanel.Dock="Top" x:Name="DeinSystemZeile" Foreground="#666" Margin="0,0,0,10" TextWrapping="Wrap" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="KategorieLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="KategorieCombo" DockPanel.Dock="Left" Width="180" Margin="0,0,16,0"
                      SelectionChanged="Filter_Changed" />
            <TextBlock x:Name="SucheLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SucheBox" Padding="4" TextChanged="Filter_Changed" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,10">
                            <StackPanel>
                                <ContentControl Content="{Binding Titel, Converter={StaticResource AmpelPrefixTextConverter}, ConverterParameter=15}"
                                                FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="{Binding KategorieText}" Foreground="#888" FontSize="11" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding WasEsIstLabel}" FontWeight="SemiBold" FontSize="11" Foreground="#555" />
                                <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding WasPassiertBeiAenderungLabel}" FontWeight="SemiBold" FontSize="11" Foreground="#555" />
                                <TextBlock Text="{Binding WasPassiertBeiAenderung}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding WannAendernLabel}" FontWeight="SemiBold" FontSize="11" Foreground="#555" />
                                <TextBlock Text="{Binding WannAendern}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding FallsProblemLabel}" FontWeight="SemiBold" FontSize="11" Foreground="#555" />
                                <TextBlock Text="{Binding FallsProblem}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
