<UserControl x:Class="PCToolbox.Modules.WindowsReparaturView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold"
                       FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" />

            <!-- Erklärkasten: das eigentliche Wissen des Moduls -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="WarumScheiternTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="WarumScheiternText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="AdminHinweis" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                    Padding="14" Margin="0,0,0,14" Visibility="Collapsed"
                    BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="AdminFehlenTitel" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource WarnBrush}" />
                    <TextBlock x:Name="AdminFehlenText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="PruefenButton"
                        Padding="18,10" Click="Pruefen_Click" />
                <Button x:Name="ReparierenButton" Padding="18,10" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="Reparieren_Click" />
                <Button x:Name="AbbrechenButton" Padding="18,10" Margin="10,0,0,0"
                        IsEnabled="False" Click="Abbrechen_Click" />
            </StackPanel>
            <TextBlock x:Name="LaufZeile" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- Ergebnis: Komponentenspeicher -->
            <Border x:Name="DismKarte" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                    Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DismTitelText"
                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <ContentControl x:Name="DismBefund" FontWeight="Bold" FontSize="14" />
                    <TextBlock x:Name="DismSchritt" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    <Expander x:Name="DismUrsacheBereich"
                              Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="DismUrsache" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </Expander>
                    <Expander x:Name="DismRohBereich"
                              Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBox x:Name="DismRoh" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Ergebnis: Systemdateien -->
            <Border x:Name="SfcKarte" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                    Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SfcTitelText" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <ContentControl x:Name="SfcBefund" FontWeight="Bold" FontSize="14" />
                    <TextBlock x:Name="SfcSchritt" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    <Expander x:Name="SfcUrsacheBereich"
                              Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="SfcUrsache" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </Expander>
                    <Expander x:Name="SfcRohBereich"
                              Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBox x:Name="SfcRoh" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock x:Name="FazitZeile" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" />

            <!-- Windows-Update-Verlauf: belegt "unterbrochenes Update" mit echten Daten statt
                 einer allgemeinen Behauptung (Rang 2 aus der NirSoft-Recherche). Laedt
                 unabhaengig von Pruefen/Reparieren beim Oeffnen des Moduls. -->
            <Expander x:Name="UpdateVerlaufBereich" Margin="0,18,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="UpdateVerlaufHinweis" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="UpdateVerlaufListe">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4">
                                    <ContentControl Content="{Binding Converter={StaticResource AmpelPrefixTextConverter}}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
