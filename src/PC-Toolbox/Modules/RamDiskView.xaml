<UserControl x:Class="PCToolbox.Modules.RamDiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4" MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="WichtigTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="WichtigText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

            <StackPanel x:Name="InstallierenPanel" Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="InstallierenErklaerung" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,8" />
                <Button x:Name="ImDiskInstallierenButton"
                        Click="ImDiskInstallieren_Click" Padding="18,10" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock x:Name="GroesseLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <ComboBox x:Name="GroesseBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,20" SelectedIndex="1">
                <ComboBoxItem Content="256 MB" Tag="256" />
                <ComboBoxItem Content="512 MB" Tag="512" />
                <ComboBoxItem Content="1 GB" Tag="1024" />
                <ComboBoxItem Content="2 GB" Tag="2048" />
                <ComboBoxItem Content="4 GB" Tag="4096" />
            </ComboBox>

            <TextBlock x:Name="LaufwerksbuchstabeLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <ComboBox x:Name="LaufwerkBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,24" SelectedIndex="0" />

            <StackPanel Orientation="Horizontal">
                <Button x:Name="ErstellenButton" Click="Erstellen_Click"
                        Padding="18,10" Margin="0,0,12,0" />
                <Button x:Name="EntfernenButton" Click="Entfernen_Click"
                        Padding="18,10" IsEnabled="False" />
            </StackPanel>

            <TextBlock x:Name="MeldungText" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
