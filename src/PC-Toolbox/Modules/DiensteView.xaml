<UserControl x:Class="PCToolbox.Modules.DiensteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="WenigKlicksTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="WenigKlicksText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ZusammenfassungText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MeldungText" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="NeuladenButton" Click="Neuladen_Click" Padding="14,7" Margin="0,0,12,0" />
            <CheckBox x:Name="AlleAnzeigenBox"
                      VerticalAlignment="Center" Click="AlleAnzeigen_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Liste">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                Padding="14,12" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Width="160" Margin="14,0,0,0">
                                    <Button Content="{Binding AufBedarfBeschriftung}" Tag="{Binding Dienst}"
                                            Click="AufBedarf_Click" Padding="10,6"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                            Visibility="{Binding UmstellenSichtbar}" />
                                    <Button Content="{Binding WiederAutoBeschriftung}" Tag="{Binding Dienst}"
                                            Click="AufAuto_Click" Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            Visibility="{Binding ZurueckSichtbar}" />
                                    <TextBlock Text="{Binding SchutzHinweis}" FontSize="10" TextWrapping="Wrap"
                                               TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Anzeigename}" FontWeight="Bold" FontSize="15"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Kurzurteil}" Foreground="{Binding AmpelFarbe}"
                                               FontWeight="SemiBold" Margin="0,4,0,6" TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Empfehlung}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Herkunft}" FontSize="11" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
