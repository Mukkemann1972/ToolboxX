<UserControl x:Class="PCToolbox.Modules.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,10" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <StackPanel x:Name="Inhalt" Margin="0,10,0,0" />

            <!-- === Verbaute Hardware (reine Anzeige) === -->
            <TextBlock x:Name="ArbeitsspeicherTitel" FontSize="15" FontWeight="Bold" Margin="0,22,0,2" />
            <TextBlock x:Name="SpeicherZusammenfassung" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
            <ItemsControl x:Name="SpeicherListe">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding LinkText}" Tag="{Binding LinkAdresse}"
                                        Click="Hersteller_Click" Padding="10,4" VerticalAlignment="Center"
                                        Visibility="{Binding LinkSichtbar}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Ueberschrift}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Zeile2}" FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="LaufwerkeTitel" FontSize="15" FontWeight="Bold" Margin="0,14,0,8" />
            <ItemsControl x:Name="LaufwerksListe">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding LinkText}" Tag="{Binding LinkAdresse}"
                                        Click="Hersteller_Click" Padding="10,4" VerticalAlignment="Center"
                                        Visibility="{Binding LinkSichtbar}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Ueberschrift}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Zeile2}" FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
