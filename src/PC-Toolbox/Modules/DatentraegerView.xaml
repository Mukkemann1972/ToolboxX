<UserControl x:Class="PCToolbox.Modules.DatentraegerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="NichtsPassierenTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="NichtsPassierenText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="LaufwerkLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <ComboBox x:Name="LaufwerkBox" Width="420" HorizontalAlignment="Left" Margin="0,0,0,6"
                      SelectionChanged="Laufwerk_Gewechselt" />
            <TextBlock x:Name="LaufwerkInfoText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"
                       Foreground="{StaticResource TextMutedBrush}" />

            <!-- === Bezeichnung & Buchstabe === -->
            <TextBlock x:Name="BezeichnungBuchstabeTitel" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="BezeichnungFeld" Width="220" Padding="6,4" Margin="0,0,10,0" />
                <Button x:Name="BezeichnungUebernehmenButton" Click="Bezeichnung_Click" Padding="12,6" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <ComboBox x:Name="BuchstabeBox" Width="80" Margin="0,0,10,0" />
                <Button x:Name="BuchstabeAendernButton" Click="Buchstabe_Click" Padding="12,6" />
            </StackPanel>

            <!-- === Größe ändern === -->
            <TextBlock x:Name="GroesseAendernTitel" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock x:Name="GroesseHinweis" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                       Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <TextBox x:Name="GroesseFeld" Width="120" Padding="6,4" Margin="0,0,8,0" />
                <TextBlock Text="GB" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="GroesseButton" Click="Groesse_Click" Padding="12,6" />
            </StackPanel>

            <!-- === Formatieren === -->
            <TextBlock x:Name="FormatierenTitel" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock x:Name="FormatWarnung" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="DateisystemBox" Width="120" Margin="0,0,12,0"
                          SelectionChanged="Dateisystem_Gewechselt" />
                <CheckBox x:Name="SchnellBox" IsChecked="True" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="DateisystemHinweis" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}" />

            <TextBlock x:Name="BestaetigungBeschriftung" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox x:Name="BestaetigungFeld" Width="220" Padding="6,4" Margin="0,0,10,0" />
                <Button x:Name="FormatierenButton" Click="Formatieren_Click" Padding="12,6" />
            </StackPanel>

            <TextBlock x:Name="MeldungText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />

            <Button x:Name="NeuLadenButton" Click="Neuladen_Click" Padding="12,6" HorizontalAlignment="Left" />

            <!-- Geister-Laufwerksbuchstaben: haeufigste, fuer Nutzer unsichtbare Ursache fuer
                 "Stick wird nicht angezeigt"/bekommt einen unerwarteten Buchstaben
                 (Rang 3 aus der NirSoft-Recherche, Vorbild DriveLetterView). -->
            <Expander x:Name="GeisterBereich" Margin="0,20,0,0" Visibility="Collapsed">
                <TextBlock x:Name="GeisterText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
