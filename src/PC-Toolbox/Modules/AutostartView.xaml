<UserControl x:Class="PCToolbox.Modules.AutostartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitelText" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFontFamily}" Margin="0,0,0,4" />
            <TextBlock x:Name="QuelleHinweis" Style="{StaticResource QuelleHinweisStyle}" />
            <TextBlock x:Name="EinleitungText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="NichtsKaputtTitel" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="NichtsKaputtText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ZusammenfassungText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MeldungText" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AktualisierenButton" Click="Aktualisieren_Click" Padding="14,7" />
            <TextBlock x:Name="HinweisText" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Width="150" Margin="14,0,0,0">
                                        <Button Content="{Binding SchalterBeschriftung}" Tag="{Binding Eintrag}"
                                                Click="Umschalten_Click" Padding="10,7" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding AdminHinweis}" FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Kurzurteil}" Foreground="{Binding AmpelFarbe}"
                                                   FontWeight="SemiBold" Margin="0,4,0,6" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding WasEsIst}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Empfehlung}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}" />

                                        <TextBlock Text="{Binding Herkunft}" FontSize="11" Margin="0,8,0,0"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Autostart V0.2: seltenere Orte, die die Liste oben bewusst nicht abdeckt -
                     RunOnce (laeuft einmalig, kein Umschalter noetig) und zwei
                     Sicherheitspruefungen (Winlogon-Shell, IFEO-Programmumleitung). -->
                <Expander x:Name="WeitereOrteBereich" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="WeitereOrteErklaerung" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                        <ItemsControl x:Name="WeitereOrteListe">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Content="{Binding Symbol, Converter={StaticResource AmpelGlyphConverter}, ConverterParameter=15}"
                                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Titel}" FontWeight="Bold" FontSize="15"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
