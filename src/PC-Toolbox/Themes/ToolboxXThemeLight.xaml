<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PCToolbox.Converters;assembly=PC-Toolbox">

    <!-- Ampel-Symbole (26.07.2026): eigene Vektorgrafik statt Emoji, s. Converters/AmpelIconFactory.cs -->
    <conv:AmpelGlyphConverter x:Key="AmpelGlyphConverter" />
    <conv:AmpelPrefixTextConverter x:Key="AmpelPrefixTextConverter" />

    <!-- ═══════════════════════════════════════════════════════════
         Toolbox X — helles Theme
         Gleiche Ressourcen-Keys/Styles wie ToolboxXTheme.xaml (dunkel),
         nur die Farbpalette ist anders - bewusst als eigenstaendige
         Datei statt Vererbung/DynamicResource, damit jedes Theme fuer
         sich alleine fertig aufgeloest ist (siehe App.xaml.cs ApplyTheme).
         ═══════════════════════════════════════════════════════════ -->

    <!-- === Farbpalette === -->
    <Color x:Key="BgDeepColor">#F4F6FA</Color>
    <Color x:Key="BgPanelColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#EEF1F6</Color>
    <Color x:Key="BgCardHoverColor">#E3E8F0</Color>
    <!-- Werden beim Start per Text-Ersetzung durch die gewaehlte Akzentfarbe
         aus den Einstellungen befuellt (s. App.xaml.cs ApplyTheme) - deshalb
         KEIN gueltiger Hex-Wert hier, sondern Platzhalter-Token. Genau darum
         ist diese Datei bewusst NICHT als WPF-Page kompiliert (s. .csproj),
         sondern liegt als Text-Vorlage neben der EXE. -->
    <Color x:Key="AccentColor">ACCENT_TOKEN</Color>
    <Color x:Key="AccentDimColor">ACCENT_DIM_TOKEN</Color>
    <Color x:Key="TextPrimaryColor">#1B2436</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="BorderColor">#D7DEE8</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="OkColor">#16A34A</Color>
    <!-- Gelbe Ampelstufe. Im hellen Theme bewusst dunkler als im dunklen Theme,
         sonst ist Gelb auf hellem Grund kaum lesbar (Kontrast geht vor Farbtreue). -->
    <Color x:Key="WarnColor">#B45309</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />

    <!-- === Glow-Effekt (dezent, für Akzent-Elemente) === -->
    <DropShadowEffect x:Key="AccentGlow" Color="{StaticResource AccentColor}"
                       BlurRadius="16" ShadowDepth="0" Opacity="0.35" />

    <!-- === Schriften (Optik-Runde 26.07.2026) ===
         Chakra Petch/Orbitron/Rajdhani, SIL Open Font License (Fonts/*/OFL.txt).
         Ordner-Referenz statt Einzeldatei: WPF waehlt anhand FontWeight die
         passende Schnittdatei selbst (z.B. Bold -> ChakraPetch-Bold.ttf). -->
    <FontFamily x:Key="DisplayFontFamily">pack://application:,,,/Fonts/ChakraPetch/#Chakra Petch</FontFamily>
    <FontFamily x:Key="AccentFontFamily">pack://application:,,,/Fonts/Orbitron/#Orbitron</FontFamily>
    <FontFamily x:Key="BodyFontFamily">pack://application:,,,/Fonts/Rajdhani/#Rajdhani</FontFamily>

    <!-- === "Woher weiss die Toolbox das?"-Hinweis (26.07.2026) ===
         Transparenz statt Blackbox: nennt die konkrete Windows-Datenquelle
         (WMI-Klasse, Event-Log, Registry-Pfad, ...) als Tooltip. -->
    <Style x:Key="QuelleHinweisStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="QUELLE_HINWEIS_TOKEN" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Margin" Value="0,2,0,10" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
    </Style>

    <!-- === Tooltips ===
         Gleicher Grund wie im dunklen Theme: ohne expliziten Style wuerde
         der globale TextBlock-Style die Schriftfarbe auch im Tooltip auf
         TextPrimaryBrush setzen - hier zufaellig dunkel genug fuer den
         hellen Windows-Standardhintergrund, aber zur Sicherheit trotzdem
         explizit festgelegt, damit ein spaeterer Farbwechsel nicht erneut
         zu unlesbaren Tooltips fuehrt. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <!-- === Fenster-Grundlage === -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- === Standard-Textblock === -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- === Eingabefelder === -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- === Standard-Button (im Inhaltsbereich, z.B. "Scannen") === -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Sidebar-Navigationseintrag === -->
    <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Margin="8,2" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Grid.Column="0" Width="3" Height="20"
                                    CornerRadius="2" Background="{StaticResource AccentBrush}"
                                    Opacity="0" Margin="-10,0,10,0" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicatorSlide" X="-6" />
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="IndicatorSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="IndicatorSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Kachel-Karte (Übersicht) === -->
    <Style x:Key="TileCardStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <!-- Eigene (nicht geteilte) Instanz statt {StaticResource AccentGlow}: eine geteilte
                                 Ressource wuerde beim Animieren gleichzeitig auf ALLEN Kacheln aufleuchten. -->
                            <DropShadowEffect x:Name="BdGlow" Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0" />
                        </Border.Effect>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="BdGlow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="BdGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Titelleisten-Button (_/□/X) === -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
